#!/usr/bin/osascript -l JavaScript
// Read or control the already-running macOS Music app from a project terminal.
function run(argv) {
    const action = argv[0] || "info";
    if (argv.length > 1 || !["info", "status", "toggle", "next", "previous"].includes(action)) {
        throw new Error("Usage: agent-music [info|status|toggle|next|previous]");
    }
    try {
        const music = Application("com.apple.Music");
        if (!music.running()) return action === "status" ? "" : "Open Music to use playback controls.";
        if (action === "toggle") music.playpause();
        if (action === "next") music.nextTrack();
        if (action === "previous") music.previousTrack();
        const state = music.playerState();
        if (state !== "playing" && state !== "paused") return action === "status" ? "" : "Music is stopped.";
        const track = music.currentTrack;
        const label = [track.name(), track.artist()].filter(Boolean).join(" — ").replace(/[\x00-\x1f\x7f]/g, " ");
        const prefix = state === "playing" ? "♪ " : "Ⅱ ";
        // tmux parses styling markers in the status line, including in track titles.
        return prefix + (action === "status" ? Array.from(label).slice(0, 34).join("").replace(/#/g, "##") : label);
    } catch (error) {
        if (action === "status") return "";
        throw new Error("Music is unavailable. Check this terminal's Automation access to Music. " + error);
    }
}
