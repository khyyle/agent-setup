#!/usr/bin/osascript -l JavaScript
// Both tab bars display the active track without launching Music or changing playback.
function run(args) {
    try {
        const music = Application("com.apple.Music");
        if (!music.running() || music.playerState() !== "playing") return "";

        const track = music.currentTrack;
        const label = [track.name(), track.artist()].filter(Boolean).join(" / ")
            .replace(/[\x00-\x1f\x7f]/g, " ").trim();
        if (!label) return "";
        const display = "♪ " + Array.from(label).slice(0, 36).join("");
        // Only tmux interprets hashes as formatting instructions.
        return args.includes("--tmux") ? display.replace(/#/g, "##") + "  " : display;
    } catch (error) {
        return "";
    }
}
